{
  "name": "behagoras-skills",
  "version": "0.1.5",
  "description": "Claude Code skills installer — npx behagoras-skills install",
  "license": "MIT",
  "author": "behagoras",
  "homepage": "https://github.com/behagoras/behagoras-skills",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/behagoras/behagoras-skills.git"
  },
  "bugs": {
    "url": "https://github.com/behagoras/behagoras-skills/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "bin": {
    "behagoras-skills": "cli/dist/index.js"
  },
  "files": [
    "cli/dist",
    "skills.json",
    "skills.schema.json",
    "video-transcript",
    "b7s-ask",
    "b7s-brainstorm",
    "b7s-create-skill",
    "b7s-prioritize",
    "b7s-review",
    "commands",
    ".transcriptsrc.example",
    "install.sh",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm build",
    "lint": "tsc --noEmit -p cli/tsconfig.json"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "ajv": "^8.17.1",
    "commander": "^12.1.0",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "claude",
    "claude-code",
    "skills",
    "cli",
    "installer"
  ]
}
