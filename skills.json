{
  "$schema": "./skills.schema.json",
  "skills": [
    {
      "name": "b7s-brainstorm",
      "description": "Freestyle brainstorm capture (Mexican Spanish) — listen, organize faithfully, save to .brainstorms/inbox/, deepen via AskUserQuestion.",
      "path": "b7s-brainstorm",
      "commands": [
        "b7s-brainstorm"
      ],
      "requires": {
        "binaries": []
      },
      "prompts": []
    },
    {
      "name": "b7s-prioritize",
      "description": "Rank executable prompts by urgency, dependencies, and TODO coverage — closes the b7s trio (brainstorm → review → prioritize). Read-only.",
      "path": "b7s-prioritize",
      "commands": [
        "b7s-prioritize"
      ],
      "requires": {
        "binaries": []
      },
      "prompts": []
    },
    {
      "name": "b7s-review",
      "description": "Review brainstorm TODOs and move files between statuses (inbox/in-progress/completed/archived). Pairs with b7s-brainstorm.",
      "path": "b7s-review",
      "commands": [
        "b7s-review"
      ],
      "requires": {
        "binaries": []
      },
      "prompts": []
    },
    {
      "name": "video-transcript",
      "description": "Extract transcripts from any video URL (YouTube, Reels, TikTok, Vimeo, ...).",
      "path": "video-transcript",
      "commands": [
        "youtube-transcript",
        "instagram-transcript",
        "tiktok-transcript",
        "video-transcript"
      ],
      "requires": {
        "binaries": [
          "yt-dlp",
          "ffmpeg",
          "python3"
        ],
        "optional": [
          {
            "binary": "mlx_whisper",
            "platforms": [
              "darwin"
            ],
            "install": "pipx install mlx-whisper"
          },
          {
            "binary": "whisper-ctranslate2",
            "platforms": [
              "linux"
            ],
            "install": "pipx install whisper-ctranslate2"
          }
        ]
      },
      "prompts": [
        {
          "key": "vault_dir",
          "question": "Where should --note save vault notes? (relative paths anchor to .transcriptsrc location)",
          "type": "select",
          "choices": [
            {
              "label": "./.transcripts (per-project, gitignored)",
              "value": "./.transcripts"
            },
            {
              "label": "./spider (matches the spider-openclaw-server pattern)",
              "value": "./spider"
            },
            {
              "label": "<obsidian-autodetect>",
              "value": "<obsidian-autodetect>"
            },
            {
              "label": "Custom path…",
              "value": "<custom>"
            }
          ],
          "default": "./.transcripts",
          "writes": {
            "file": ".transcriptsrc",
            "key": "vault_dir"
          }
        },
        {
          "key": "default_with_timestamps",
          "question": "Always emit per-cue timestamps?",
          "type": "confirm",
          "default": false,
          "writes": {
            "file": ".transcriptsrc",
            "key": "default_with_timestamps"
          }
        },
        {
          "key": "default_force_audio",
          "question": "Always skip captions and use Whisper audio path?",
          "type": "confirm",
          "default": false,
          "writes": {
            "file": ".transcriptsrc",
            "key": "default_force_audio"
          }
        }
      ]
    }
  ]
}
